# Variables del servidor de Nexora (Cloudflare). Aquí van SOLO los nombres, nunca los valores.
# Los valores se guardan como secretos en Cloudflare:  npx wrangler secret put NOMBRE --config servidor/wrangler.jsonc

# El correo de pruebas que lee y desde el que contesta Nexora.
CORREO_USUARIO=
# Contraseña de aplicación de Google (16 letras). NO es la contraseña del correo.
CORREO_CONTRASENA=
# Con qué nombre sales en las respuestas por correo.
CORREO_NOMBRE=
# Clave de un solo uso para crear la primera cuenta del dueño. Se borra después.
CLAVE_ARRANQUE=
