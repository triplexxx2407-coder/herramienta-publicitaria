{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["src/**/*.ts", "../lib/redes.ts", "../lib/tipos.ts"]
}
